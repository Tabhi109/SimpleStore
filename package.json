{
  "name": "simplestore-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "SimpleStore - Your store. Without the complexity.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "lint:web": "npm run lint --workspace=apps/web",
    "type-check:web": "npm run type-check --workspace=apps/web",
    "test:api": "pytest apps/api/tests",
    "test:e2e": "npm run test:e2e --workspace=apps/web"
  },
  "keywords": [
    "ecommerce",
    "nextjs",
    "fastapi",
    "postgresql",
    "redis",
    "portfolio"
  ],
  "author": "SimpleStore Team",
  "license": "MIT"
}

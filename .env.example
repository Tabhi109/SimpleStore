# ==============================================================================
# SimpleStore Environment Configuration Template
# Copy this file to .env before starting the application
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment & App Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
APP_NAME=SimpleStore
API_V1_STR=/api/v1
PROJECT_URL=http://localhost:3000
API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=simplestore_db
POSTGRES_USER=simplestore_user
POSTGRES_PASSWORD=simplestore_password
# Complete SQLAlchemy Database URI (Async & Sync)
DATABASE_URL=postgresql+asyncpg://simplestore_user:simplestore_password@localhost:5432/simplestore_db
DATABASE_SYNC_URL=postgresql://simplestore_user:simplestore_password@localhost:5432/simplestore_db

# ------------------------------------------------------------------------------
# Redis (Cache & Rate Limiting)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------------------------
# Generate a secure key in production using: openssl rand -hex 32
JWT_SECRET_KEY=development_jwt_secret_key_super_secure_and_long_enough_for_hs256
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# AI Provider (Sarvam AI) - Optional Enhancement
# ------------------------------------------------------------------------------
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_API_URL=https://api.sarvam.ai
SARVAM_MODEL=sarvam-2b

# ------------------------------------------------------------------------------
# Neon Postgres (optional — takes precedence over local DATABASE_URL)
# ------------------------------------------------------------------------------
NEON_DB_URL=

# ------------------------------------------------------------------------------
# Object Storage (Vercel Blob preferred, local disk fallback)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
BLOB_READ_WRITE_TOKEN=
S3_BUCKET_NAME=simplestore-uploads
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# Frontend (Next.js Public Variables)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
